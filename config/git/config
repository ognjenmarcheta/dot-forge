# Global git config (git reads ~/.config/git/config next to ~/.gitconfig).
# Your name/email and anything machine-specific go in ~/.config/git/local,
# which is not committed — install.sh asks for them on a new machine.
# Example for a separate work identity in ~/.config/git/local:
#   [includeIf "gitdir:~/Github/helu/"]
#       path = ~/.config/git/work

[include]
    path = ~/.config/git/local

[init]
    defaultBranch = main

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true          # n / N jump between files
    line-numbers = true
    syntax-theme = TwoDark

[merge]
    conflictStyle = zdiff3

[diff]
    algorithm = histogram
    colorMoved = default

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[rerere]
    enabled = true           # remember how you resolved a conflict

[branch]
    sort = -committerdate

[alias]
    st = status -sb
    co = checkout
    sw = switch
    lg = log --graph --pretty=format:'%C(yellow)%h%Creset %C(blue)%an%Creset %C(green)(%cr)%Creset%C(auto)%d%Creset %s' -20
    last = log -1 --stat
    amend = commit --amend --no-edit
    undo = reset --soft HEAD~1
    unstage = restore --staged
    recent = branch --sort=-committerdate --format='%(committerdate:relative)%09%(refname:short)' -15
