#!/usr/bin/env bash
# dot-ai — every AI feature in these dotfiles goes through this script.
#
# It only ever uses Claude Code logged in with YOUR CLAUDE SUBSCRIPTION:
#   * API-key / cloud-provider variables are removed before Claude Code starts
#   * it asks Claude Code how it's logged in and refuses anything that isn't
#     the subscription login (API key, key helper, Bedrock/Vertex…)
# Usage counts toward your subscription limits, never an API bill.
#
#   echo "data" | dot-ai [--fast] [--system TEXT] [--timeout SECS] ["instruction"]
#   dot-ai --check        exit 0 if Claude Code uses the subscription login
#
#   --fast       quickest model (haiku) — for small jobs like fixing a typo
#   AI_MODEL     model for normal jobs (default: sonnet)
set -uo pipefail

unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL \
    CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY

model="${AI_MODEL:-sonnet}"
system=""
timeout_s=180
check_only=0
while [ $# -gt 0 ]; do
    case "$1" in
        --fast) model=haiku; timeout_s=20 ;;
        --model) model="$2"; shift ;;
        --system) system="$2"; shift ;;
        --timeout) timeout_s="$2"; shift ;;
        --check) check_only=1 ;;
        --) shift; break ;;
        *) break ;;
    esac
    shift
done

claude_bin=""
for c in "$(command -v claude 2>/dev/null)" "$HOME/.local/bin/claude" "$HOME/.claude/local/claude"; do
    if [ -n "$c" ] && [ -x "$c" ]; then claude_bin="$c"; break; fi
done
if [ -z "$claude_bin" ]; then
    echo "dot-ai: Claude Code isn't installed — install it, then run \`claude\` and log in with your Claude account" >&2
    exit 3
fi

# --- subscription check (cached for 6 hours) ---------------------------------
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles"
cache="$cache_dir/claude-auth"
auth_ok() {
    local now method
    now=$(date +%s)
    if [ -f "$cache" ] && [ $(( now - $(cat "$cache" 2>/dev/null || echo 0) )) -lt 21600 ]; then
        return 0
    fi
    method=$("$claude_bin" auth status 2>/dev/null | jq -r '.authMethod // empty' 2>/dev/null)
    case "$method" in
        claude.ai|oauth_token) ;;                       # subscription login / its long-lived token
        "")
            # older Claude Code without `auth status`: accept a stored claude.ai login
            if ! grep -qs claudeAiOauth "$HOME/.claude/.credentials.json" && [ "$(uname -s)" != Darwin ]; then
                echo "dot-ai: Claude Code isn't logged in — run \`claude auth login\` with your Claude account" >&2
                return 1
            fi ;;
        none)
            echo "dot-ai: Claude Code isn't logged in — run \`claude auth login\` with your Claude account" >&2
            return 1 ;;
        *)
            echo "dot-ai: Claude Code is logged in with \"$method\" (API billing)." >&2
            echo "        These dotfiles only use your Claude subscription: run \`claude auth login\`" >&2
            echo "        and choose your Claude account (not Console)." >&2
            return 1 ;;
    esac
    mkdir -p "$cache_dir" && date +%s > "$cache"
}
auth_ok || exit 4
[ "$check_only" -eq 1 ] && exit 0

# --- run ------------------------------------------------------------------------
to=""
if command -v timeout >/dev/null 2>&1; then to="timeout $timeout_s"
elif command -v gtimeout >/dev/null 2>&1; then to="gtimeout $timeout_s"; fi

args=(-p --model "$model" --tools "" --no-session-persistence --output-format text)
[ -n "$system" ] && args+=(--system-prompt "$system")
[ $# -gt 0 ] && args+=("$*")

# shellcheck disable=SC2086
$to "$claude_bin" "${args[@]}"
