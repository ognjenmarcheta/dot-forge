#!/usr/bin/env bash
# dot — manage the dotfiles repo from anywhere.
#
#   dot status          what changed in the repo (configs are links, so edits show up here)
#   dot save "message"  commit everything and push
#   dot upgrade         pull, re-link, upgrade tools (Neovim plugins stay pinned)
#   dot doctor [--nvim] check this machine matches the dotfiles
#   dot edit            open the repo in your editor
#   dot keys            cheat sheet of the shortcuts this setup adds
#   dot standup         yesterday / today / blockers from your commits, PRs, notes
#   dot update [CLIENT] this week's update for a client, ready to send
#   dot note "text"     jot down what happened (calls, decisions, waiting on…)
#   dot clients         which repo belongs to which client (--init to start)
#   dot save-game [NAME] keep this WezTerm workspace (tabs, splits, programs, branches)
#   dot load-game NAME  bring a saved workspace back (also after a reboot)
#   dot games           list saves
#   dot sync-history    sync shell history between your machines (atuin + Bitwarden)
#   dot sessions [kill] WezTerm tabs kept in the background / end them all
#   dot new NAME        new project from Kaine Forge (--client acme, --local, --dry-run)
#   dot night "repo: task"  Claude works on it overnight in a worktree (dot night = queue)
#   dot recall PATTERN  search what your commands printed (--ai "question", --last 5)
#   dot habits          turn long commands you keep typing into aliases
#   dot mode share [CLIENT]  screen-share mode (dot mode work to end)
#   dot invite          a read-only browser link to one terminal tab (--for 2h, stop)
#   dot try owner/repo  any repo in a throwaway container + a tour (list, shell, rm)
#   dot janitor         free disk space old projects sit on (node_modules, caches…)
#   dot evolve          this week's friction → a draft PR that fixes some of it
#   cd "$(dot dir)"     go to the repo
set -euo pipefail

find_repo() {
    if [ -n "${DOTFILES_DIR:-}" ]; then printf '%s' "$DOTFILES_DIR"; return; fi
    local link
    link=$(readlink "$HOME/.config/shell" 2>/dev/null || true)   # …/dotfiles/config/shell
    if [ -n "$link" ]; then printf '%s' "${link%/config/shell}"; return; fi
    printf '%s' "$HOME/Github/dotfiles"
}
DOT="$(find_repo)"
[ -d "$DOT/.git" ] || { echo "dot: no dotfiles repo at $DOT (set DOTFILES_DIR)" >&2; exit 1; }

keys() {
    cat <<'EOF'
WezTerm  (leader = Alt+q, then the key)
  Leader c / x        new tab / close pane         Leader | / -   split right / down
  Leader b / n        previous / next tab          Leader 0-9     go to tab
  Leader w / W        pick workspace / new one     Leader arrows  resize pane
  Ctrl+h/j/k/l        move between panes AND Neovim splits (falls through to the
                      shell when there's no pane that way, so Ctrl+L still clears)
  Alt+h/j/k/l         resize panes / Neovim splits
  Ctrl+click          open a link inside nvim / lazygit / btop
  Leader p            projects in ~/Github → workspace with shell / nvim / lazygit tabs
  Shift+↑ / Shift+↓   jump to the previous / next command (like Warp blocks)
  Leader y            copy the last command's output     triple-click  select an output
  Leader Space        label URLs, paths, hashes, IPs, HELU-123… → type the label to copy
  Leader u            same, for URLs → opens it
  Ctrl+Shift+P        command palette (projects, rename tab, edit dotfiles…)
  Ctrl+Shift+U        emoji / symbol picker
  ● / ✓ on a tab      Claude Code is waiting for you / finished there
  Leader a            agent radar: every Claude session (● needs you, ⟳ working, ✓ done) → jump
  Leader ?            Claude in a side pane, already told about the folder, git and last output
  ▌ + badge colour    the git project the tab / pane is in (same colour every time)
  red flash           a command failed · warmer, dimmer colours after 22:00 (machine.lua: night = false)
  right of tab bar    ● agents waiting · CPU / GPU °C · RAM · 🐳 containers · CI runner
  save points         palette "Save game" / "Load game…", or dot save-game / load-game / games
  closing the window  tabs keep running; reopen WezTerm to get them back
                      (dot sessions = list them, dot sessions kill = end all)

Shell
  z <name> / z <Tab>  jump to a frequent folder / pick from a menu
                      (a typo or missing letter → the closest folder)
  y                   yazi file manager (cd's to where you quit)
  → (right arrow)     accept the grey suggestion (zsh); Ctrl+→ takes one word
  Tab                 fuzzy completion menu with previews (zsh, fzf-tab)
  Ctrl+R              atuin history search        Ctrl+T  insert a file   Alt+C  cd into a folder
  rgf <text>          search file contents, open the hit in nvim
  ll / lt             list with git status / tree   (entries are clickable)
  ai <request>        shell command from Claude    ai explain <cmd>
  ai fix              right after a failure: reads the error on screen, suggests a fix
  F1                  use the 💡 fix suggested under the prompt after a typo (DOT_FIX=0 = off)
  Alt+V               push-to-talk: speak, press a key → ai "…" (speech stays on this machine)
  cd into a repo      after 3+ days away: welcome card (branch, PRs, CI, what others pushed)
  Ctrl+G              navi: saved commands with blanks to fill in (~/.config/navi/cheats)
  tldr <cmd>          short examples instead of the man page
  Tab                 completions for gh, docker, kubectl, npm… (carapace)
  just / fx / xh      task runner / JSON viewer / friendlier curl
  dot …               this tool

Prompt
  click ↑ = cd ..   click a path segment = open folder   click branch = GitHub

Work (AI uses your Claude subscription only — never an API key)
  dot standup         yesterday / today / blockers, copied (--week, --since "nov 1", --edit)
  dot update acme     client update for this week (--hours, --lang sr, --edit)
  dot note "text"     note what happened; ends up in standups and client updates
  dot clients         which repo belongs to which client (--init creates the list)
  dot upgrade         pull the dotfiles and upgrade tools (was `dot update`)
  dot new portal --client acme   new repo from Kaine Forge: adopted, AI set up, CI, workspace
  dot night "api: fix the flaky test"   Claude does it at 01:30 in a worktree; morning report at
                      your first prompt → dot night diff / pr / open ID (never pushes by itself)
  dot recall "5173"   find anything a command printed, even in closed tabs (--ai "question")
  dot habits          your long repeated commands → aliases or navi recipes (hint once a week)
  dot mode share acme screen share: bigger font, no notifications, other clients' tabs hidden,
                      `cat .env`-style commands ask twice · dot mode work = back to normal
  dot invite          read-only browser link (+ QR) to a new shared tab; they can't type
                      (--for 2h, --local, dot invite status / stop)
  dot try owner/repo  clone + install in a locked-down container, Claude tour incl. red flags,
                      shell inside; gone after 24h (--keep, --port 3000, list, rm)
  dot janitor         node_modules/.turbo/dist/target… of projects untouched 30+ days,
                      old Docker images, unused caches → asks, then frees (hint weekly)
  dot evolve          weekly from your failures, lookups and rituals: Claude fixes the
                      dotfiles at night and opens a draft PR (DOT_EVOLVE=0 = off)

Neovim
  Alt+↑ / Alt+↓       add cursor above / below (multi-cursor)
  :PluginsRestore     put plugins back on the tested versions
EOF
}

# Bitwarden CLI, unlocked (BW_SESSION set, or unlock now). Fails quietly if unavailable.
bw_ready() {
    command -v bw >/dev/null 2>&1 || return 1
    local st
    st="$(bw status 2>/dev/null | jq -r .status 2>/dev/null)"
    case "$st" in
        unlocked) return 0 ;;
        locked)
            echo "Unlocking Bitwarden (master password):"
            BW_SESSION="$(bw unlock --raw)" || return 1
            export BW_SESSION ;;
        *) return 1 ;;   # not logged in: `bw login` first
    esac
}

ATUIN_BW_ITEM="atuin sync key"

sync_history() {
    command -v atuin >/dev/null || { echo "atuin isn't installed (run install.sh)"; exit 1; }
    if [ -f "${XDG_DATA_HOME:-$HOME/.local/share}/atuin/session" ]; then
        echo "Already syncing:"; atuin status 2>/dev/null | sed -n '1,6p'; atuin sync; return
    fi
    echo "Sync shell history (Ctrl+R, and the grey suggestions in zsh) between your"
    echo "machines. End-to-end encrypted: the server only stores encrypted data; the"
    echo "key stays on your machines (and in Bitwarden, if you use it)."
    printf 'Is this your first machine (no atuin account yet)? [y/N] '
    read -r first || exit 1
    local user email key=""
    case "$first" in
        y|Y|yes)
            printf 'Username: '; read -r user
            printf 'E-mail:   '; read -r email
            atuin register -u "$user" -e "$email" || exit 1
            key="$(atuin key)"
            if bw_ready; then
                bw get template item | jq --arg k "$key" --arg n "$ATUIN_BW_ITEM" \
                    '.type = 2 | .secureNote = {type: 0} | .name = $n | .notes = $k | .login = null' \
                    | bw encode | bw create item >/dev/null && bw sync >/dev/null \
                    && echo "✓ key saved in Bitwarden as \"$ATUIN_BW_ITEM\""
            else
                echo
                echo "Save this key in Bitwarden (secure note \"$ATUIN_BW_ITEM\"); other machines need it:"
                echo "  $key"
            fi
            ;;
        *)
            printf 'Username: '; read -r user
            if bw_ready; then key="$(bw get notes "$ATUIN_BW_ITEM" 2>/dev/null || true)"; fi
            if [ -n "$key" ]; then
                echo "✓ key from Bitwarden"
                atuin login -u "$user" -k "$key" || exit 1
            else
                echo "(no Bitwarden CLI or no \"$ATUIN_BW_ITEM\" note: paste the key when asked)"
                atuin login -u "$user" || exit 1
            fi
            ;;
    esac
    atuin sync && echo "✓ history synced; it keeps syncing in the background"
}

sessions() {
    command -v wezterm >/dev/null || { echo "wezterm not found"; exit 1; }
    if [ "${1:-}" = kill ]; then
        printf 'End ALL WezTerm sessions, including running programs? [y/N] '
        read -r a; case "$a" in y|Y|yes) ;; *) exit 0 ;; esac
        if pkill -f wezterm-mux-server; then echo "✓ session server stopped"; else echo "no session server running"; fi
        return
    fi
    wezterm cli --prefer-mux list 2>/dev/null || echo "no session server running (persistent sessions off?)"
}

case "${1:-help}" in
    status|st)
        git -C "$DOT" status -sb
        ;;
    save)
        shift
        msg="${*:-Update dotfiles}"
        git -C "$DOT" add -A
        if git -C "$DOT" diff --cached --quiet; then echo "dot: nothing to save"; exit 0; fi
        git -C "$DOT" commit -m "$msg"
        git -C "$DOT" push
        ;;
    upgrade|up)
        # A pull that can't happen (local edits, local commits, another branch)
        # used to stop everything with git's message. Now: local edits are
        # stashed and put back, any other problem is explained, and the tools
        # are upgraded either way.
        pull_problem=""
        branch=$(git -C "$DOT" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
        if [ -z "$branch" ]; then
            pull_problem="the dotfiles repo is not on a branch (detached HEAD) — run: git -C $DOT switch main"
        elif ! git -C "$DOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
            pull_problem="branch '$branch' has no upstream to pull from — run: git -C $DOT switch main"
        elif ! git -C "$DOT" pull --ff-only --autostash; then
            ahead=$(git -C "$DOT" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
            behind=$(git -C "$DOT" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)
            if [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
                pull_problem="this machine has $ahead commit(s) origin doesn't, and origin has $behind new — run: git -C $DOT pull --rebase && git -C $DOT push"
            else
                pull_problem="git pull failed (see above) — check: git -C $DOT status"
            fi
        fi
        if [ -n "$pull_problem" ]; then
            printf 'dot upgrade: dotfiles NOT updated: %s\n' "$pull_problem" >&2
            printf 'dot upgrade: upgrading the tools with the config you have now…\n' >&2
        fi
        rc=0
        "$DOT/install.sh" --upgrade || rc=$?
        if [ "$rc" -ne 0 ]; then
            printf '\ndot upgrade: install.sh --upgrade failed (exit %s) — the first error above is the cause\n' "$rc" >&2
            [ -n "$pull_problem" ] && printf 'dot upgrade: and the dotfiles were NOT pulled: %s\n' "$pull_problem" >&2
            exit "$rc"
        fi
        if [ -n "$pull_problem" ]; then
            printf '\ndot upgrade: tools upgraded, but the dotfiles were NOT pulled: %s\n' "$pull_problem" >&2
            exit 1
        fi
        ;;
    doctor|check)
        shift
        exec "$DOT/tests/doctor.sh" "$@"
        ;;
    edit)
        cd "$DOT" && exec "${EDITOR:-nvim}" .
        ;;
    dir)
        printf '%s\n' "$DOT"
        ;;
    keys)
        keys
        ;;
    standup|update|note|notes|clients)
        work="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/dot-work"
        if command -v uv >/dev/null 2>&1; then
            exec uv run --quiet --script "$work" "$@"
        elif python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
            exec python3 "$work" "$@"
        else
            echo "dot: needs uv or Python 3.11+ (run install.sh)" >&2; exit 1
        fi
        ;;
    new)
        shift
        exec "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/dot-new" "$@"
        ;;
    mode|invite|try)
        tool="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/dot-$1"
        shift
        exec "$tool" "$@"
        ;;
    night|recall|habits|janitor|evolve)
        tool="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/dot-$1"
        shift
        if command -v uv >/dev/null 2>&1; then
            exec uv run --quiet --script "$tool" "$@"
        elif python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
            exec python3 "$tool" "$@"
        else
            echo "dot: needs uv or Python 3.11+ (run install.sh)" >&2; exit 1
        fi
        ;;
    save-game|load-game)
        [ "${TERM_PROGRAM:-}" = WezTerm ] || { echo "dot: save points live in WezTerm — run this in a WezTerm tab" >&2; exit 1; }
        var=dot_save; [ "$1" = load-game ] && var=dot_load
        name="${2:-}"
        if [ "$var" = dot_load ] && [ -z "$name" ]; then echo "usage: dot load-game NAME   (dot games lists them)" >&2; exit 1; fi
        printf '\033]1337;SetUserVar=%s=%s\007' "$var" "$(printf '%s' "${name:-__workspace__}" | base64 | tr -d '\n')"
        if [ "$var" = dot_save ]; then echo "💾 saving ${name:-this workspace}… (WezTerm shows a notification)"
        else echo "▶ loading $name…"; fi
        ;;
    games)
        saves="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/saves"
        if ! ls "$saves"/*.json >/dev/null 2>&1; then echo "no saves yet — dot save-game NAME"; exit 0; fi
        for f in "$saves"/*.json; do
            jq -r --arg f "$(basename "$f" .json)" \
                '"\($f)\t\(.saved_at | strflocaltime("%a %d %b %H:%M"))\t\([.windows[].tabs[]] | length) tabs\t\([.windows[].tabs[].panes[]] | length) panes"' "$f" 2>/dev/null
        done | awk -F'\t' '{ printf "%-24s %-18s %s · %s\n", $1, $2, $3, $4 }'
        ;;
    sync-history|sync)
        sync_history
        ;;
    sessions)
        shift
        sessions "$@"
        ;;
    help|-h|--help|*)
        awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
        ;;
esac
