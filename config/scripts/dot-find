#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# ///
"""dot find — find a project by what it is, not by its folder name.

    z "the billing thing for acme"      jump there (z falls back to this when
                                        zoxide finds nothing for 2+ words)
    dot find "react native app"         the best matches and why
    dot find --cd "QUERY"               print the best folder (what z uses);
                                        asks with fzf when it's a close call
    dot find --index                    rebuild the index now
    dot find --status                   what's indexed and how

Each git repo under ~/Github (DOT_PROJECTS; two levels deep) and every repo
zoxide knows is described by its name, client (clients.toml), README,
package.json / pyproject / Cargo description, top-level files and recent
commit subjects. Ranking mixes keyword matching with a small embedding model
that runs on this machine (fastembed, BAAI/bge-small-en-v1.5, downloaded once
through uv). Nothing is sent anywhere. Without uv or the model it falls back
to keywords alone.

  DOT_FIND_EMBED=0        keywords only
  DOT_FIND_MODEL=NAME     another fastembed model (e.g. a multilingual one)
  DOT_FIND_EMBED_CMD=CMD  embedder command (JSON in, vectors out; for tests)
"""
from __future__ import annotations

import argparse
import fnmatch
import json
import math
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from collections import Counter
from pathlib import Path

HOME = Path.home()
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "dotfiles" / "find"
INDEX = CACHE / "index.json"
CLIENTS = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "dotfiles" / "clients.toml"
MODEL = os.environ.get("DOT_FIND_MODEL", "BAAI/bge-small-en-v1.5")
STALE = 12 * 3600          # older index: used, and refreshed in the background
MAX_REPOS = 400
VERSION = 2

STOP = set("""a an the and or of for to in on at by with from my our your this that these those
thing things stuff one ones project projects repo repos repository folder dir directory code
where wheres which what is was it its i me we us go goto jump take open find old new""".split())


def say(msg: str) -> None:
    print(msg, file=sys.stderr)


def run(args: list[str], cwd: Path | None = None, timeout: float = 10) -> str:
    try:
        return subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def short(p: str) -> str:
    h = str(HOME)
    return "~" + p[len(h):] if p == h or p.startswith(h + "/") else p


# ------------------------------------------------------------------ text ---

def words(text: str) -> list[str]:
    text = re.sub(r"([a-z])([A-Z])", r"\1 \2", text)          # camelCase
    return [w for w in re.split(r"[^a-z0-9]+", text.lower()) if w]


def stem(w: str) -> str:
    for suf in ("ing", "ies", "es", "s", "ed"):
        if len(w) > len(suf) + 3 and w.endswith(suf):
            return w[: -len(suf)] + ("y" if suf == "ies" else "")
    return w


def terms(text: str, stop: bool = False) -> list[str]:
    return [stem(w) for w in words(text) if not (stop and w in STOP) and len(w) > 1]


def clean_markdown(text: str) -> str:
    text = re.sub(r"```.*?```", " ", text, flags=re.S)       # code blocks
    text = re.sub(r"<[^>]+>", " ", text)                     # html
    text = re.sub(r"!\[[^\]]*\]\([^)]*\)", " ", text)        # images / badges
    text = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)     # links → their text
    text = re.sub(r"https?://\S+", " ", text)
    text = re.sub(r"[#>*_`|]+", " ", text)
    return "\n".join(ln.strip() for ln in text.splitlines() if ln.strip())


# ----------------------------------------------------------------- repos ---

def roots() -> list[Path]:
    out = [Path(os.environ.get("DOT_PROJECTS", HOME / "Github"))]
    try:
        raw = tomllib.loads(CLIENTS.read_text())
        for r in raw.get("settings", {}).get("roots", []):
            out.append(Path(os.path.expandvars(os.path.expanduser(r))))
    except (OSError, tomllib.TOMLDecodeError):
        pass
    return out


def is_repo(d: Path) -> bool:
    return (d / ".git").exists()     # a .git file = a worktree, indexed too


def find_repos() -> list[Path]:
    found: dict[str, Path] = {}
    for root in roots():
        if not root.is_dir():
            continue
        if is_repo(root):
            found[str(root)] = root
        for d in sorted(root.iterdir()):
            if d.name.startswith(".") or not d.is_dir():
                continue
            if is_repo(d):
                found[str(d)] = d
                continue
            try:
                kids = sorted(d.iterdir())
            except OSError:
                continue
            for c in kids:
                if c.is_dir() and not c.name.startswith(".") and is_repo(c):
                    found[str(c)] = c
    if shutil.which("zoxide"):
        for line in run(["zoxide", "query", "--list"]).splitlines():
            p = Path(line.strip())
            if line.strip() and str(p) not in found and is_repo(p):
                found[str(p)] = p
    return list(found.values())[:MAX_REPOS]


def clients() -> dict[str, tuple[str, list[str]]]:
    try:
        raw = tomllib.loads(CLIENTS.read_text())
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    return {k: (v.get("name", k), list(v.get("repos", []))) for k, v in raw.items()
            if k != "settings" and isinstance(v, dict)}


def client_of(path: Path, remote: str, cl: dict) -> str:
    for key, (name, pats) in cl.items():
        for pat in pats:
            if pat.startswith(("~", "/", "$")):
                pp = os.path.expandvars(os.path.expanduser(pat)).rstrip("/")
                if fnmatch.fnmatch(str(path), pp) or str(path) == pp or str(path).startswith(pp + "/"):
                    return f"{key} {name}"
            elif remote and fnmatch.fnmatch(remote, pat.lower().removesuffix(".git")):
                return f"{key} {name}"
    return ""


def remote_of(p: Path) -> str:
    url = run(["git", "-C", str(p), "remote", "get-url", "origin"]).strip()
    url = re.sub(r"^[a-z+]+://", "", url)
    url = re.sub(r"^[^@/]+@", "", url)
    if re.match(r"^[^/]+:[^/]", url):
        url = url.replace(":", "/", 1)
    return url.removesuffix(".git").lower()


def read(p: Path, limit: int = 20000) -> str:
    try:
        return p.read_text(errors="replace")[:limit]
    except OSError:
        return ""


def readme_of(p: Path) -> Path | None:
    for name in ("README.md", "readme.md", "README.markdown", "README.rst", "README.txt", "README"):
        if (p / name).is_file():
            return p / name
    return None


def signature(p: Path) -> str:
    parts = [run(["git", "-C", str(p), "rev-parse", "HEAD"]).strip()]
    for f in (readme_of(p), p / "package.json", p / "pyproject.toml", p / "Cargo.toml"):
        try:
            parts.append(str(f.stat().st_mtime_ns) if f else "-")
        except OSError:
            parts.append("-")
    return "|".join(parts)


def describe(p: Path, cl: dict) -> dict:
    remote = remote_of(p)
    desc = []
    pkg = p / "package.json"
    if pkg.is_file():
        try:
            j = json.loads(read(pkg))
            desc += [j.get("description") or "", " ".join(j.get("keywords") or [])]
        except (ValueError, AttributeError):
            pass
    for f, key in ((p / "pyproject.toml", "project"), (p / "Cargo.toml", "package")):
        if f.is_file():
            try:
                desc.append(tomllib.loads(read(f)).get(key, {}).get("description", ""))
            except (tomllib.TOMLDecodeError, AttributeError):
                pass
    rd = readme_of(p)
    readme = clean_markdown(read(rd)) if rd else ""
    commits = run(["git", "-C", str(p), "log", "-40", "--no-merges", "--format=%s"]).splitlines()
    try:
        files = sorted(x.name for x in p.iterdir() if not x.name.startswith("."))[:50]
    except OSError:
        files = []
    client = client_of(p, remote, cl)
    group, branch = str(p), ""
    if (p / ".git").is_file():       # a worktree: grouped with its main repo
        common = run(["git", "-C", str(p), "rev-parse", "--path-format=absolute", "--git-common-dir"]).strip()
        if common:
            group = str(Path(common).parent)
        branch = run(["git", "-C", str(p), "branch", "--show-current"]).strip()
    desc_text = " ".join(d for d in desc if d).strip()
    first = next((ln for ln in readme.splitlines() if len(ln) > 30), "")
    return {
        "path": str(p), "name": p.name, "remote": remote, "client": client,
        "desc": desc_text, "readme": readme[:4000], "commits": commits, "files": files,
        "summary": desc_text or first,
        "group": group, "branch": branch,
        "sig": signature(p),
    }


def chunks(r: dict) -> list[str]:
    """What gets embedded: who/what it is, the README, what changed lately."""
    head = f"{r['name'].replace('-', ' ')}. {r['client']} {r['desc']} {r['remote']}".strip()
    if r.get("branch"):
        head += f" (worktree, branch {r['branch'].replace('-', ' ')})"
    out = [f"{head}\n{r['readme'][:900]}"]
    if len(r["readme"]) > 900:
        out.append(f"{r['name']}: {r['readme'][900:2400]}")
    if r["commits"]:
        out.append(f"{r['name']} recent work: " + "; ".join(r["commits"][:25]))
    return out


# ------------------------------------------------------------ embeddings ---

WORKER = r'''
import json, os, sys
from fastembed import TextEmbedding
req = json.load(sys.stdin)
m = TextEmbedding(req["model"], cache_dir=req["cache"])
f = m.query_embed if req["kind"] == "query" else m.passage_embed
json.dump([[round(float(x), 5) for x in v] for v in f(req["texts"])], sys.stdout)
'''


def embed(texts: list[str], kind: str) -> list[list[float]] | None:
    if os.environ.get("DOT_FIND_EMBED", "1") == "0" or not texts:
        return None
    cmd = os.environ.get("DOT_FIND_EMBED_CMD")
    if cmd:
        args = shlex.split(cmd)
    elif shutil.which("uv"):
        args = ["uv", "run", "--quiet", "--no-project", "--with", "fastembed>=0.9,<1",
                "python", "-c", WORKER]
    else:
        return None
    env = dict(os.environ, HF_HUB_DISABLE_PROGRESS_BARS="1", HF_HUB_DISABLE_TELEMETRY="1",
               TOKENIZERS_PARALLELISM="false")
    req = {"model": MODEL, "cache": str(CACHE / "models"), "kind": kind, "texts": texts}
    try:
        res = subprocess.run(args, input=json.dumps(req), capture_output=True, text=True,
                             timeout=600, env=env)
        vecs = json.loads(res.stdout) if res.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        vecs = None
    if not isinstance(vecs, list) or len(vecs) != len(texts):
        return None
    return vecs


def cos(a: list[float], b: list[float]) -> float:
    dot = sum(x * y for x, y in zip(a, b))
    na = math.sqrt(sum(x * x for x in a)) or 1.0
    nb = math.sqrt(sum(y * y for y in b)) or 1.0
    return dot / (na * nb)


# ------------------------------------------------------------------ index ---

def load_index() -> dict:
    try:
        idx = json.loads(INDEX.read_text())
        if idx.get("version") == VERSION:
            return idx
    except (OSError, ValueError):
        pass
    return {"version": VERSION, "built": 0, "model": "", "repos": []}


def save_index(idx: dict) -> None:
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = INDEX.with_suffix(".tmp")
    tmp.write_text(json.dumps(idx))
    tmp.replace(INDEX)


def build_index(quiet: bool = False) -> dict:
    old = load_index()
    by_path = {r["path"]: r for r in old["repos"]}
    want_model = MODEL if os.environ.get("DOT_FIND_EMBED", "1") != "0" else ""
    cl = clients()
    repos, todo = [], []
    for p in find_repos():
        prev = by_path.get(str(p))
        sig = signature(p)
        if prev and prev.get("sig") == sig and (prev.get("vecs") or not want_model) \
                and old.get("model") == want_model:
            repos.append(prev)
            continue
        r = describe(p, cl)
        r["vecs"] = []
        repos.append(r)
        todo.append(r)
    # every reused entry was embedded with want_model (or none is wanted)
    model = want_model
    if want_model and todo:
        texts, owners = [], []
        for r in todo:
            for c in chunks(r):
                texts.append(c)
                owners.append(r)
        if not quiet:
            first = not os.environ.get("DOT_FIND_EMBED_CMD") and not (CACHE / "models").exists()
            say(f"dot find: reading {len(todo)} project{'s' if len(todo) != 1 else ''}"
                + (" (first time: downloading a small local model, ~30 s)" if first else "") + "…")
        vecs = embed(texts, "passage")
        if vecs:
            for r, v in zip(owners, vecs):
                r["vecs"].append(v)
        else:
            model = ""      # keywords only; the next --index tries the model again
            for r in repos:
                r["vecs"] = []
            if not quiet:
                say("dot find: no embedding model (uv / fastembed) — matching keywords only")
    idx = {"version": VERSION, "built": time.time(), "model": model, "repos": repos}
    save_index(idx)
    return idx


def refresh_in_background() -> None:
    try:
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "--index", "--quiet"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def get_index() -> dict:
    idx = load_index()
    if not idx["repos"]:
        return build_index()
    if time.time() - idx.get("built", 0) > STALE:
        refresh_in_background()
    return idx


# ---------------------------------------------------------------- ranking ---

def doc_fields(r: dict) -> list[tuple[str, float]]:
    return [
        (r["name"], 3.0), (r.get("branch", ""), 2.0), (r["client"], 3.0), (r["remote"], 1.0), (r["desc"], 2.0),
        (r["readme"], 1.0), (" ".join(r["commits"]), 0.6), (" ".join(r["files"]), 0.5),
    ]


def lexical(query: list[str], repos: list[dict]) -> list[float]:
    """BM25 with field weights (name and client count most)."""
    if not query or not repos:
        return [0.0] * len(repos)
    tfs, lens = [], []
    for r in repos:
        tf: Counter = Counter()
        n = 0.0
        for text, w in doc_fields(r):
            for t in terms(text):
                tf[t] += w
                n += w
        tfs.append(tf)
        lens.append(n)
    avg = sum(lens) / len(lens) or 1.0
    N = len(repos)
    out = []
    for tf, ln in zip(tfs, lens):
        s = 0.0
        for q in set(query):
            df = sum(1 for t in tfs if q in t)
            if not df or q not in tf:
                continue
            idf = math.log(1 + (N - df + 0.5) / (df + 0.5))
            f = tf[q]
            s += idf * f * 2.2 / (f + 1.2 * (0.25 + 0.75 * ln / avg))
        out.append(s)
    return out


def frecency() -> dict[str, float]:
    if not shutil.which("zoxide"):
        return {}
    out = {}
    for line in run(["zoxide", "query", "--list", "--score"]).splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) == 2:
            try:
                out[parts[1]] = float(parts[0])
            except ValueError:
                pass
    return out


def why(r: dict, query: list[str]) -> str:
    """The line of what we know about it that best matches the query."""
    q = set(query)
    lines = [r["desc"]] + r["readme"].splitlines()[:80] + r["commits"][:40]
    if r["client"]:
        lines.insert(0, "client: " + r["client"].split(" ", 1)[-1])
    best, best_n = "", 0
    for ln in lines:
        n = len(q & set(terms(ln)))
        if n > best_n and len(ln) > 3:
            best, best_n = ln, n
    text = best or r["summary"] or r["remote"] or ""
    text = re.sub(r"\s+", " ", text).strip()
    return text if len(text) <= 72 else text[:71] + "…"


def rank(query: str, idx: dict) -> list[tuple[float, dict, str]]:
    repos = [r for r in idx["repos"] if Path(r["path"]).is_dir()]
    if not repos:
        return []
    q = terms(query, stop=True) or terms(query)
    lex = lexical(q, repos)
    top_lex = max(lex) or 1.0
    sem = [0.0] * len(repos)
    if idx.get("model") and any(r.get("vecs") for r in repos):
        qv = embed([query], "query")
        if qv:
            sem = [max((cos(qv[0], v) for v in r.get("vecs") or []), default=0.0) for r in repos]
    fre = frecency()
    top_fre = max(fre.values(), default=0.0) or 1.0
    have_sem = any(sem)
    lo = min(sem) if have_sem else 0.0
    hi = max(sem) if have_sem else 1.0
    out = []
    for r, l, s in zip(repos, lex, sem):
        ln = l / top_lex
        # a word of the query is the project's name, branch or client: that
        # beats any amount of "sounds similar"
        name_hit = 0.35 if q and set(q) & set(terms(f"{r['name']} {r.get('branch', '')} {r['client']}")) else 0.0
        if have_sem:
            # a floor on the spread: when every project is about as close,
            # small differences in meaning shouldn't look decisive
            sn = (s - lo) / max(hi - lo, 0.12)
            score = 0.5 * sn + 0.35 * ln + name_hit
        else:
            score = 0.85 * ln + name_hit
        score += 0.05 * fre.get(r["path"], 0.0) / top_fre
        if r.get("branch"):
            score -= 0.06          # same README as the main repo: the main repo wins ties
        out.append((score, r, why(r, q)))
    out.sort(key=lambda x: -x[0])
    return out


def confident(ranked: list) -> bool:
    """Clearly ahead of the best match from another project (its own
    worktrees don't count: they share its README)."""
    if not ranked:
        return False
    top = ranked[0]
    others = [s for s, r, _ in ranked[1:] if r.get("group", r["path"]) != top[1].get("group", top[1]["path"])]
    return not others or top[0] - others[0] >= 0.12


def pick(query: str, ranked: list) -> str | None:
    """A close call: let fzf decide (on the terminal), else the best one."""
    if not (shutil.which("fzf") and os.path.exists("/dev/tty")) or os.environ.get("DOT_FIND_NO_PICK"):
        return ranked[0][1]["path"]
    lines = "\n".join(f"{r['name']}\t{w}\t{r['path']}" for _, r, w in ranked[:8])
    try:
        with open("/dev/tty", "r+") as tty:
            res = subprocess.run(
                ["fzf", "--delimiter", "\t", "--with-nth", "1,2", "--height", "40%", "--reverse",
                 "--no-sort", "--prompt", f"z “{query}” > ", "--header", "which one? (Esc = none)"],
                input=lines, stdout=subprocess.PIPE, stderr=tty, text=True)
    except OSError:
        return ranked[0][1]["path"]
    if res.returncode != 0 or not res.stdout.strip():
        return None
    return res.stdout.strip().split("\t")[-1]


# -------------------------------------------------------------------- main ---

def main() -> int:
    ap = argparse.ArgumentParser(prog="dot find", description="find a project by what it is")
    ap.add_argument("query", nargs="*")
    ap.add_argument("--cd", action="store_true", help="print the best folder (for z)")
    ap.add_argument("--index", action="store_true", help="rebuild the index")
    ap.add_argument("--status", action="store_true", help="what's indexed")
    ap.add_argument("--quiet", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("-n", type=int, default=5, help="how many matches to list (default 5)")
    a = ap.parse_args()

    if a.index:
        idx = build_index(quiet=a.quiet)
        if not a.quiet:
            how = f"meaning ({idx['model']}) + keywords" if idx["model"] else "keywords only"
            print(f"indexed {len(idx['repos'])} projects — {how}")
        return 0
    if a.status:
        idx = load_index()
        if not idx["repos"]:
            print("not indexed yet — dot find --index")
            return 0
        age = int((time.time() - idx["built"]) / 60)
        how = f"meaning ({idx['model']}) + keywords" if idx["model"] else "keywords only"
        print(f"{len(idx['repos'])} projects, {how}, updated {age} min ago ({short(str(INDEX))})")
        for r in sorted(idx["repos"], key=lambda r: r["name"]):
            print(f"  {r['name']:<28} {short(r['path'])}")
        return 0

    query = " ".join(a.query).strip()
    if not query:
        ap.print_usage(sys.stderr)
        return 2
    ranked = rank(query, get_index())
    if not ranked:
        say("dot find: no projects found (DOT_PROJECTS / ~/Github, or zoxide's folders)")
        return 1

    if a.cd:
        path = ranked[0][1]["path"] if confident(ranked) else pick(query, ranked)
        if not path:
            return 1
        w = next(w for _, rr, w in ranked if rr["path"] == path)
        say(f"z: “{query}” → {short(path)}" + (f"  ({w})" if w else ""))
        print(path)
        return 0

    tty = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    B, D, G, R = ("\033[1m", "\033[2m", "\033[32m", "\033[0m") if tty else ("", "", "", "")
    for i, (score, r, w) in enumerate(ranked[: a.n]):
        mark = f"{G}→{R}" if i == 0 and confident(ranked) else " "
        print(f"{mark} {B}{r['name']}{R}  {D}{short(r['path'])}{R}")
        if w:
            print(f"    {w}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
