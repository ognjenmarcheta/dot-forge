#!/usr/bin/env bash
# dot new — start a new (client) project from your Kaine Forge template.
#
#   dot new NAME [options]
#     --title "Acme Portal"   product name (default: NAME in Title Case)
#     --client KEY            file the repo under this client (dot standup / update / mode share)
#     --owner OWNER           GitHub user or org (default: you)
#     --public                public repo (default: private)
#     --id software.x.y       desktop reverse-DNS id (default: software.byteforge.<name>)
#     --local                 no GitHub: a local copy of the template (no push, no settings)
#     --yes                   don't ask; also applies GitHub settings and CI runners
#     --dry-run               show the steps only
#
# Steps: create OWNER/NAME from ognjenmarcheta/kaine-forge → clone into
# ~/Github/NAME → pnpm install → template:adopt (from template-adoption.json) →
# ai:install → ai:doctor → template:adopt --check → commit + push → github:setup
# --apply → self-hosted CI runners (if your k3s cluster is set up) → client
# mapping → open it as a workspace. The adoption commit has no AI attribution
# (the template's commitlint rejects it).
set -euo pipefail

TEMPLATE="${DOT_NEW_TEMPLATE:-ognjenmarcheta/kaine-forge}"
PROJECTS="${DOT_PROJECTS:-$HOME/Github}"
SCRIPTS="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"

name="" title="" client="" owner="" visibility="--private" ident="" local=0 yes=0 dry=0
while [ $# -gt 0 ]; do
    case "$1" in
        --title) title="$2"; shift ;;
        --client) client="$2"; shift ;;
        --owner) owner="$2"; shift ;;
        --public) visibility="--public" ;;
        --id) ident="$2"; shift ;;
        --local) local=1 ;;
        --yes|-y) yes=1 ;;
        --dry-run|-n) dry=1 ;;
        -h|--help) sed -n '2,/^set -e/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
        -*) echo "dot new: unknown option $1" >&2; exit 2 ;;
        *) if [ -z "$name" ]; then name="$1"; else echo "dot new: one NAME only" >&2; exit 2; fi ;;
    esac
    shift
done
[ -n "$name" ] || { sed -n '2,/^set -e/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 2; }
[[ "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || { echo "dot new: NAME should be lowercase letters, digits, - . _" >&2; exit 2; }

b() { printf '\033[1m%s\033[0m' "$*"; }
step() { printf '\n\033[1;35m▸\033[0m %s\n' "$*"; }
note() { printf '  \033[2m%s\033[0m\n' "$*"; }
die() { printf '\033[31mdot new: %s\033[0m\n' "$*" >&2; exit 1; }
run() { # show, then run (unless --dry-run)
    printf '  \033[36m$ %s\033[0m\n' "$*"
    [ "$dry" -eq 1 ] || "$@"
}
ask() { # question → 0 = yes
    [ "$yes" -eq 1 ] && return 0
    [ -t 0 ] || return 1
    local a; read -r -p "  $1 [Y/n] " a
    case "$a" in ""|y|Y|yes) return 0 ;; *) return 1 ;; esac
}
uservar() {
    [ "${TERM_PROGRAM:-}" = WezTerm ] || return 0
    printf '\033]1337;SetUserVar=%s=%s\007' "$1" "$(printf '%s' "$2" | base64 | tr -d '\n')"
}

[ -n "$title" ] || title="$(printf '%s' "$name" | tr '._-' '   ' | awk '{for (i=1;i<=NF;i++) $i=toupper(substr($i,1,1)) substr($i,2)} 1')"
[ -n "$ident" ] || ident="software.byteforge.$(printf '%s' "$name" | tr -cd 'a-z0-9')"
[[ "$ident" =~ ^[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z][A-Za-z0-9_-]*)+$ ]] || die "--id must be reverse-DNS, like software.byteforge.portal"
dest="$PROJECTS/$name"
[ -e "$dest" ] && die "$dest already exists"

# --- tools ------------------------------------------------------------------
need() { command -v "$1" >/dev/null 2>&1 || die "needs $1${2:+ ($2)}"; }
need git
if [ "$local" -eq 0 ]; then
    need gh "brew/apt install gh, then gh auth login"
    gh auth status >/dev/null 2>&1 || die "gh isn't logged in — gh auth login"
    [ -n "$owner" ] || owner="$(gh api user --jq .login)"
else
    owner="${owner:-local}"
fi
if [ "$dry" -eq 0 ]; then
    need node "mise use -g node@22"
    node_major="$(node -p 'process.versions.node.split(".")[0]')"
    [ "$node_major" -ge 22 ] || die "Kaine Forge needs Node 22+, you have $(node -v) — mise use -g node@22"
fi
PNPM=(pnpm)
if ! command -v pnpm >/dev/null 2>&1; then
    if command -v corepack >/dev/null 2>&1; then PNPM=(corepack pnpm)
    elif [ "$dry" -eq 0 ]; then die "needs pnpm — corepack enable (or mise use -g pnpm)"
    fi
fi

printf '%s %s  %s\n' "$(b "New project:")" "$title" "$(printf '\033[2m%s · %s · %s\033[0m' "$owner/$name" "$ident" "${client:-no client}")"

# --- 1. the repo -------------------------------------------------------------
if [ "$local" -eq 1 ]; then
    step "Copy the template (local only)"
    run git clone --quiet --depth 1 "https://github.com/$TEMPLATE.git" "$dest"
    if [ "$dry" -eq 0 ]; then
        rm -rf "$dest/.git"
        git -C "$dest" init --quiet -b main
        git -C "$dest" add -A
        git -C "$dest" -c core.hooksPath=/dev/null commit --quiet -m "chore: start from the Kaine Forge template"
    fi
else
    step "Create $owner/$name from $TEMPLATE"
    run gh repo create "$owner/$name" --template "$TEMPLATE" "$visibility" --description "$title"
    if [ "$dry" -eq 0 ]; then
        # GitHub copies the template in the background
        for _ in $(seq 1 30); do
            gh api "repos/$owner/$name/commits?per_page=1" --jq '.[0].sha' >/dev/null 2>&1 && break
            sleep 2
        done
    fi
    run gh repo clone "$owner/$name" "$dest" -- --quiet
fi

# --- 2. adopt ----------------------------------------------------------------
step "Make it $title (template adoption)"
cfg="$(jq -n --arg p "$title" --arg o "$owner" --arg s "$name" --arg d "$ident" \
    '{productName: $p, repoOwner: $o, repoSlug: $s, desktopIdentifier: $d}')"
printf '%s\n' "$cfg" | sed 's/^/  /'
if [ "$dry" -eq 0 ]; then
    printf '%s\n' "$cfg" > "$dest/template-adoption.json"
    cd "$dest"
fi
run "${PNPM[@]}" install
run "${PNPM[@]}" template:adopt --config template-adoption.json --write
[ "$dry" -eq 1 ] || rm -f template-adoption.json   # recorded in .ai/project/template.json

step "AI setup (Claude Code, Codex …: skills, MCP, rules)"
run "${PNPM[@]}" ai:install -- --non-interactive
run "${PNPM[@]}" ai:doctor || note "ai:doctor found something — see above (not blocking)"
run "${PNPM[@]}" template:adopt --check || note "leftover Kaine Forge names above — review them later"

# --- 3. first commit ---------------------------------------------------------
step "Commit"
run git add -A
# conventional commit, no AI attribution: the template's commitlint rejects it
run git commit --quiet -m "chore: adopt Kaine Forge template as $title"
if [ "$local" -eq 0 ]; then
    run git push --quiet origin HEAD

    # --- 4. GitHub settings and CI ------------------------------------------
    step "GitHub settings (labels, rulesets, merge rules, security, project board)"
    if ask "Apply .github/repo-setup.json to $owner/$name now?"; then
        run "${PNPM[@]}" github:setup --apply || note "some settings need attention — pnpm github:setup --check"
    else
        note "later: cd $dest && pnpm github:setup --apply"
    fi

    runners="$PROJECTS/kaine-forge/tooling/ci-runners/ci-runners.sh"
    if [ -x "$runners" ] && [ -f "$HOME/.kube/k3s-arc.yaml" ]; then
        step "Self-hosted CI runners on this machine"
        if ask "Add $owner/$name to your k3s runner scale sets?"; then
            run "$runners" add-repo "$owner/$name" || note "runner setup failed — rerun: $runners add-repo $owner/$name"
            note "if the arc GitHub App is installed on selected repos only, add $name to it on GitHub"
        fi
    else
        note "CI runs on GitHub-hosted runners (no ~/.kube/k3s-arc.yaml) — set CI_SELF_HOSTED_LINUX later"
    fi
fi

# --- 5. your setup ------------------------------------------------------------
if [ -n "$client" ]; then
    step "File it under client $client"
    if command -v uv >/dev/null 2>&1; then work=(uv run --quiet --script "$SCRIPTS/dot-work")
    else work=(python3 "$SCRIPTS/dot-work"); fi
    local_tilde='~'   # stored as ~/… so clients.toml works on every machine (portable to bash 3.2)
    run "${work[@]}" clients --add "$client" "${dest/#$HOME/$local_tilde}"
fi

printf '\n\033[1;32m✓ %s is ready\033[0m  %s\n' "$title" "$dest"
cat <<EOF
  next:  pnpm env:ensure          # .env from .env.example (set ALLOW_LOCAL_DB_PUSH=true)
         pnpm quick-setup         # Postgres + storage in Docker, build, seed, pnpm dev
         after adoption: rotate the secrets and defaults in .env.example
EOF
[ "$dry" -eq 1 ] || uservar dot_open "$dest"
