# macOS packages for install.sh (brew bundle)

tap "nikitabobko/tap"

# terminal + shell
cask "wezterm"
brew "starship"
brew "zoxide"
brew "fzf"
brew "atuin"
brew "coreutils"        # gls: clickable `ls` links
brew "git"
