brew "sevenzip"

# AI coding agents
brew "opencode"          # OpenCode CLI (used by the opencode.nvim plugin)

# misc CLI
brew "btop"
brew "fastfetch"
brew "thefuck"
brew "vhs"
brew "terminal-notifier" # herdr script notifications

# window manager
